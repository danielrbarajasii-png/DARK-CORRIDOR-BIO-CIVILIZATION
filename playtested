        // ==========================================
        // 11. MAIN UPDATE LOOP (FIRST-PERSON 3D ENGINE)
        // ==========================================
        function updateGame(dt, now) {
            if (gameState !== 'PLAYING' || !player) return;

            if (screenShake > 0) {
                screenShake = Math.max(0, screenShake - dt * 0.025);
            }

            if (player.recoilBloom > 0) {
                player.recoilBloom = Math.max(0, player.recoilBloom - dt * 0.065);
            }
            if (player.recoilKickZ > 0) {
                player.recoilKickZ = Math.max(0, player.recoilKickZ - dt * 0.015);
            }
            if (player.recoilPitch > 0) {
                player.recoilPitch = Math.max(0, player.recoilPitch - dt * 0.0004);
            }

            if (muzzleFlashLight && muzzleFlashLight.intensity > 0) {
                muzzleFlashLight.intensity = Math.max(0, muzzleFlashLight.intensity - dt * 0.045);
                if (muzzleFlashLight.intensity <= 0.1 && muzzleFlashMesh) {
                    muzzleFlashMesh.visible = false;
                }
            }

            if (player.hitmarkerTimer > 0) {
                player.hitmarkerTimer = Math.max(0, player.hitmarkerTimer - dt);
            }

            // Smooth 180° Quick-Turn Interpolation
            if (targetQuickTurnYaw !== null) {
                const diff = targetQuickTurnYaw - player.angle;
                if (Math.abs(diff) < 0.05) {
                    player.angle = targetQuickTurnYaw;
                    targetQuickTurnYaw = null;
                } else {
                    player.angle += diff * Math.min(1, dt * 0.022);
                }
            }

            // Smooth Delayed Ghost Damage Bars
            if (player.ghostHp > player.hp) {
                player.ghostHp = Math.max(player.hp, player.ghostHp - dt * 0.025);
            } else {
                player.ghostHp = player.hp;
            }

            if (player.ghostShield > player.shield) {
                player.ghostShield = Math.max(player.shield, player.ghostShield - dt * 0.035);
            } else {
                player.ghostShield = player.shield;
            }

            if (player.invulnTimer > 0) {
                player.invulnTimer = Math.max(0, player.invulnTimer - dt);
            }

            // Shield Regeneration
            if (player.shieldRegenDelay > 0) {
                player.shieldRegenDelay = Math.max(0, player.shieldRegenDelay - dt);
            } else if (player.shield < player.maxShield) {
                player.shield = Math.min(player.maxShield, player.shield + dt * 0.008);
            }

            // QECC Shockwave Cooldown
            if (player.shockwaveCooldown > 0) {
                player.shockwaveCooldown = Math.max(0, player.shockwaveCooldown - dt);
            }

            // Handle Weapon Reload Completion
            if (player.reloading) {
                const wep = weapons[player.weaponIndex];
                if (now - player.reloadStartTime >= wep.reloadTime) {
                    const needed = wep.magSize - wep.currentMag;
                    if (wep.reserveAmmo === Infinity) {
                        wep.currentMag = wep.magSize;
                    } else {
                        const transfer = Math.min(needed, wep.reserveAmmo);
                        wep.currentMag += transfer;
                        wep.reserveAmmo -= transfer;
                    }
                    player.reloading = false;
                    sound.playReload();
                    updateHud();
                }
            }

            // First-Person Relative Locomotion (Forward/Back along Heading + Strafe Left/Right)
            let forwardInput = 0;
            let strafeInput = 0;
            if (keys['KeyW'] || keys['ArrowUp']) forwardInput += 1;
            if (keys['KeyS'] || keys['ArrowDown']) forwardInput -= 1;
            if (keys['KeyD']) strafeInput += 1;
            if (keys['KeyA']) strafeInput -= 1;
            // ArrowLeft/Right rotate camera yaw on keyboard-only setups
            if (keys['ArrowLeft']) player.angle -= 0.045 * (dt / 16.67);
            if (keys['ArrowRight']) player.angle += 0.045 * (dt / 16.67);

            if (touchControls.moveActive) {
                forwardInput += -touchControls.moveDy;
                strafeInput += touchControls.moveDx;
            }

            const inputMag = Math.hypot(forwardInput, strafeInput);
            if (inputMag > 0.04) {
                const normF = forwardInput / Math.max(1, inputMag);
                const normS = strafeInput / Math.max(1, inputMag);
                const isSprinting = (keys['ShiftLeft'] || keys['ShiftRight'] || normF > 0.85) && !isAds;
                const moveSpeed = player.speed * (isSprinting ? 1.24 : isAds ? 0.72 : 1.0);

                const fwdX = Math.cos(player.angle);
                const fwdY = Math.sin(player.angle);
                const rightX = -Math.sin(player.angle);
                const rightY = Math.cos(player.angle);

                player.x += (fwdX * normF + rightX * normS) * moveSpeed * (dt / 16.67);
                player.y += (fwdY * normF + rightY * normS) * moveSpeed * (dt / 16.67);
                resolveObstacleCollisions(player);

                player.walkBobPhase += dt * (isSprinting ? 0.015 : 0.011);
            }

            // Magnetic Aim-Assist & Auto-Fire On Target (Ideal for Mobile FPS Touchscreen)
            let crosshairTargetHost = null;
            let smallestAngDiff = 0.22;
            for (const e of enemies) {
                const dx = e.x - player.x;
                const dy = e.y - player.y;
                const dist = Math.hypot(dx, dy);
                if (dist > 680) continue;

                const angToHost = Math.atan2(dy, dx);
                let angDiff = Math.atan2(Math.sin(angToHost - player.angle), Math.cos(angToHost - player.angle));
                const angularRadius = Math.atan2(e.radius * 1.35, dist);

                if (Math.abs(angDiff) < angularRadius + 0.035) {
                    crosshairTargetHost = e;
                }
                if (Math.abs(angDiff) < smallestAngDiff) {
                    smallestAngDiff = Math.abs(angDiff);
                    if (aimAssistEnabled && (touchControls.lookActive || touchControls.aimActive || touchControls.moveActive)) {
                        player.angle += angDiff * 0.085 * (dt / 16.67);
                    }
                }
            }

            // Trigger Firing (Manual Trigger OR Mobile Auto-Fire when Crosshair Locks onto a Host)
            if (mouse.down || touchControls.aimActive || (autoFireEnabled && crosshairTargetHost && !player.reloading)) {
                fireCurrentWeapon(now);
            }

            // Update Wave Spawning
            if (waveData.enemiesSpawned < waveData.enemiesToSpawn) {
                waveData.spawnTimer -= dt;
                if (waveData.spawnTimer <= 0) {
                    spawnEnemy();
                    waveData.enemiesSpawned++;
                    waveData.spawnTimer = waveData.spawnInterval;
                    updateHud();
                }
            } else if (enemies.length === 0) {
                // Wave Cleared -> Advance to next Breach Wave
                waveData.waveNumber++;
                waveData.enemiesToSpawn = Math.round(12 + waveData.waveNumber * 5.5);
                waveData.enemiesSpawned = 0;
                waveData.spawnInterval = Math.max(420, 1150 - waveData.waveNumber * 65);
                waveData.spawnTimer = 2600;

                // Bonus Wave Clear Reward
                player.shards += 20;
                waveData.totalShardsEarned += 20;
                showTacticalBanner(
                    `BREACH WAVE ${String(waveData.waveNumber).padStart(2, '0')} INCOMING`,
                    `WAVE ${waveData.waveNumber - 1} CONTAINED (+20 Og SHARDS) // HOST MUTATION ESCALATING`,
                    "cyan"
                );
                triggerCommsLog(waveData.waveNumber - 1);
                updateHud();
            }

            // Update Secondary Objective (Overheating QECC Node)
            if (!activeQeccNode) {
                waveData.qeccNodeCooldown -= dt;
                if (waveData.qeccNodeCooldown <= 0) {
                    spawnQeccNodeObjective();
                    waveData.qeccNodeCooldown = 26000;
                }
            } else {
                activeQeccNode.timeLeft -= dt;
                if (qeccNodeMeshGroup && qeccNodeMeshGroup.userData.crystal) {
                    qeccNodeMeshGroup.userData.crystal.rotation.y += 0.04;
                    qeccNodeMeshGroup.userData.crystal.rotation.x += 0.02;
                }
                const distToNode = Math.hypot(player.x - activeQeccNode.x, player.y - activeQeccNode.y);
                if (distToNode <= activeQeccNode.radius) {
                    activeQeccNode.progress = Math.min(100, activeQeccNode.progress + dt * 0.022);
                }

                document.getElementById('hudObjectiveTimer').textContent = `${Math.max(0, activeQeccNode.timeLeft / 1000).toFixed(1)}s`;
                document.getElementById('hudObjectiveBar').style.width = `${activeQeccNode.progress}%`;

                if (activeQeccNode.progress >= 100) {
                    sound.playChime(880);
                    haptics.shockwave();
                    player.shards += 45;
                    waveData.totalShardsEarned += 45;
                    waveData.totalNodesStabilized++;
                    careerData.totalNodes++;
                    saveCareerProfile();
                    player.shield = player.maxShield;
                    showTacticalBanner("QECC RESONANCE NODE STABILIZED", "+45 OGANESSON-294 SHARDS HARVESTED // SHIELD RESTORED", "emerald");
                    document.getElementById('hudObjectiveBanner').classList.add('hidden');
                    if (qeccNodeMeshGroup && scene3D) {
                        scene3D.remove(qeccNodeMeshGroup);
                        qeccNodeMeshGroup = null;
                    }
                    activeQeccNode = null;
                    updateHud();
                } else if (activeQeccNode.timeLeft <= 0) {
                    document.getElementById('hudObjectiveBanner').classList.add('hidden');
                    if (qeccNodeMeshGroup && scene3D) {
                        scene3D.remove(qeccNodeMeshGroup);
                        qeccNodeMeshGroup = null;
                    }
                    activeQeccNode = null;
                }
            }

            // Update 3D Automated Sentry Turrets
            for (let i = turrets.length - 1; i >= 0; i--) {
                const t = turrets[i];
                t.life -= dt;
                if (t.life <= 0) {
                    spawnParticles(t.x, t.y, "#10b981", 10, 3, 3, 18);
                    if (t.mesh && scene3D) scene3D.remove(t.mesh);
                    turrets.splice(i, 1);
                    updateHud();
                    continue;
                }

                t.fireCooldown -= dt;
                if (t.fireCooldown <= 0 && enemies.length > 0) {
                    let closest = null;
                    let minDist = 380;
                    for (const e of enemies) {
                        const d = Math.hypot(e.x - t.x, e.y - t.y);
                        if (d < minDist) {
                            minDist = d;
                            closest = e;
                        }
                    }
                    if (closest) {
                        t.angle = Math.atan2(closest.y - t.y, closest.x - t.x);
                        if (t.mesh) t.mesh.rotation.y = -t.angle + Math.PI / 2;
                        t.fireCooldown = 260;

                        let sentryBoltMesh = null;
                        if (scene3D) {
                            sentryBoltMesh = new THREE.Mesh(
                                new THREE.BoxGeometry(0.6, 0.6, 8),
                                new THREE.MeshBasicMaterial({ color: 0x10b981 })
                            );
                            sentryBoltMesh.position.set(t.x, 18, t.y);
                            sentryBoltMesh.rotation.y = -t.angle + Math.PI / 2;
                            scene3D.add(sentryBoltMesh);
                        }

                        bullets.push({
                            x: t.x + Math.cos(t.angle) * 16,
                            y: t.y + Math.sin(t.angle) * 16,
                            zHeight: 18,
                            vx: Math.cos(t.angle) * 19,
                            vy: Math.sin(t.angle) * 19,
                            vz: 0,
                            damage: 18,
                            isHeadshotCapable: false,
                            pierce: 1,
                            knockback: 2,
                            color: "#10b981",
                            isRail: false,
                            hitIds: new Set(),
                            life: 55,
                            mesh: sentryBoltMesh
                        });
                    }
                }
            }

            // Update Player & Turret 3D Bullets
            for (let i = bullets.length - 1; i >= 0; i--) {
                const b = bullets[i];
                b.x += b.vx * (dt / 16.67);
                b.y += b.vy * (dt / 16.67);
                b.zHeight = (b.zHeight || 26) + (b.vz || 0) * (dt / 16.67);
                b.life -= dt / 16.67;

                if (b.mesh) {
                    b.mesh.position.set(b.x, b.zHeight, b.y);
                }

                if (b.life <= 0 || b.x < 0 || b.x > WORLD_WIDTH || b.y < 0 || b.y > WORLD_HEIGHT) {
                    if (b.mesh && scene3D) scene3D.remove(b.mesh);
                    bullets.splice(i, 1);
                    continue;
                }

                // Check obstacle collisions
                let hitWall = false;
                for (const obs of obstacles) {
                    if (b.x >= obs.x && b.x <= obs.x + obs.w && b.y >= obs.y && b.y <= obs.y + obs.h) {
                        spawnParticles(b.x, b.y, b.color, 4, 3, 2, b.zHeight);
                        hitWall = true;
                        break;
                    }
                }
                if (hitWall) {
                    if (b.mesh && scene3D) scene3D.remove(b.mesh);
                    bullets.splice(i, 1);
                    continue;
                }

                // Check enemy collisions
                for (let j = enemies.length - 1; j >= 0; j--) {
                    const e = enemies[j];
                    if (b.hitIds.has(e.id)) continue;

                    const dist = Math.hypot(b.x - e.x, b.y - e.y);
                    if (dist <= e.radius + 5) {
                        b.hitIds.add(e.id);
                        const isCrit = b.isHeadshotCapable && Math.random() < 0.45;
                        const finalDmg = isCrit ? Math.round(b.damage * 1.5) : b.damage;
                        e.hp -= finalDmg;
                        sound.playHit(false);
                        if (player && e.hp > 0) {
                            player.hitmarkerTimer = 115;
                            player.hitmarkerKill = false;
                            player.hitmarkerCrit = isCrit;
                        }

                        // Knockback
                        const kbAng = Math.atan2(b.vy, b.vx);
                        e.x += Math.cos(kbAng) * b.knockback;
                        e.y += Math.sin(kbAng) * b.knockback;

                        spawnParticles(b.x, b.y, isCrit ? "#fbbf24" : e.color, 5, 3.2, 2.5, 28);
                        addFloatingText(e.x, e.y, isCrit ? `CRIT ${finalDmg}!` : `${finalDmg}`, isCrit ? "#fbbf24" : b.color, isCrit ? 14 : 12);

                        if (e.hp <= 0) {
                            handleEnemyDeath(e, j);
                        }

                        b.pierce--;
                        if (b.pierce <= 0) {
                            if (b.mesh && scene3D) scene3D.remove(b.mesh);
                            bullets.splice(i, 1);
                            break;
                        }
                    }
                }
            }

            // Update 3D Enemy Projectiles (Mutagen Spitter globules)
            for (let i = enemyProjectiles.length - 1; i >= 0; i--) {
                const ep = enemyProjectiles[i];
                ep.x += ep.vx * (dt / 16.67);
                ep.y += ep.vy * (dt / 16.67);
                ep.life -= dt / 16.67;

                if (ep.mesh) {
                    ep.mesh.position.set(ep.x, 26, ep.y);
                }

                if (ep.life <= 0) {
                    if (ep.mesh && scene3D) scene3D.remove(ep.mesh);
                    enemyProjectiles.splice(i, 1);
                    continue;
                }

                let hitWall = false;
                for (const obs of obstacles) {
                    if (ep.x >= obs.x && ep.x <= obs.x + obs.w && ep.y >= obs.y && ep.y <= obs.y + obs.h) {
                        hitWall = true;
                        break;
                    }
                }
                if (hitWall) {
                    spawnParticles(ep.x, ep.y, "#c084fc", 5, 2.5, 2.5, 26);
                    if (ep.mesh && scene3D) scene3D.remove(ep.mesh);
                    enemyProjectiles.splice(i, 1);
                    continue;
                }

                if (Math.hypot(ep.x - player.x, ep.y - player.y) <= player.radius + ep.radius) {
                    applyDamageToPlayer(ep.damage, ep.x, ep.y);
                    spawnParticles(ep.x, ep.y, "#c084fc", 8, 3.5, 3, 26);
                    if (ep.mesh && scene3D) scene3D.remove(ep.mesh);
                    enemyProjectiles.splice(i, 1);
                }
            }

            // Update Bio-Acid Pools
            for (let i = acidPools.length - 1; i >= 0; i--) {
                const pool = acidPools[i];
                pool.life -= dt / 16.67;
                if (pool.mesh) {
                    pool.mesh.material.opacity = Math.min(0.55, (pool.life / pool.maxLife) * 0.55);
                }
                if (pool.life <= 0) {
                    if (pool.mesh && scene3D) scene3D.remove(pool.mesh);
                    acidPools.splice(i, 1);
                    continue;
                }
                if (Math.hypot(player.x - pool.x, player.y - pool.y) < pool.radius) {
                    applyDamageToPlayer(8, pool.x, pool.y);
                }
            }

            // Update 3D Enemies (AI Locomotion, Limb Animation & Attacks)
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                if (e.stunTimer > 0) {
                    e.stunTimer -= dt;
                    resolveObstacleCollisions(e);
                    if (e.mesh) e.mesh.position.set(e.x, 0, e.y);
                    continue;
                }

                const dx = player.x - e.x;
                const dy = player.y - e.y;
                const dist = Math.hypot(dx, dy) || 0.001;
                let dirAngle = Math.atan2(dy, dx);

                if (e.type === 'stalker') {
                    dirAngle += Math.sin(now * 0.009 + e.phaseOffset) * 0.65;
                }

                if (e.type === 'spitter') {
                    if (dist > 290) {
                        e.x += Math.cos(dirAngle) * e.speed * (dt / 16.67);
                        e.y += Math.sin(dirAngle) * e.speed * (dt / 16.67);
                    } else if (dist < 190) {
                        e.x -= Math.cos(dirAngle) * (e.speed * 0.6) * (dt / 16.67);
                        e.y -= Math.sin(dirAngle) * (e.speed * 0.6) * (dt / 16.67);
                    }
                    e.shootCooldown -= dt;
                    if (e.shootCooldown <= 0 && dist < 520) {
                        e.shootCooldown = 1900;
                        let globMesh = null;
                        if (scene3D) {
                            globMesh = new THREE.Mesh(
                                new THREE.SphereGeometry(4.5, 8, 8),
                                new THREE.MeshBasicMaterial({ color: 0xc084fc })
                            );
                            globMesh.position.set(e.x, 26, e.y);
                            scene3D.add(globMesh);
                        }
                        enemyProjectiles.push({
                            x: e.x,
                            y: e.y,
                            vx: Math.cos(dirAngle) * 7.5,
                            vy: Math.sin(dirAngle) * 7.5,
                            radius: 6,
                            damage: e.damage,
                            life: 95,
                            mesh: globMesh
                        });
                    }
                } else {
                    e.x += Math.cos(dirAngle) * e.speed * (dt / 16.67);
                    e.y += Math.sin(dirAngle) * e.speed * (dt / 16.67);
                }

                // Soft separation between enemies
                for (let j = i - 1; j >= 0; j--) {
                    const other = enemies[j];
                    const edx = e.x - other.x;
                    const edy = e.y - other.y;
                    const edist = Math.hypot(edx, edy);
                    const minSep = e.radius + other.radius;
                    if (edist > 0 && edist < minSep) {
                        const push = (minSep - edist) * 0.25;
                        e.x += (edx / edist) * push;
                        e.y += (edy / edist) * push;
                        other.x -= (edx / edist) * push;
                        other.y -= (edy / edist) * push;
                    }
                }

                resolveObstacleCollisions(e);

                // Sync 3D Host Mesh & Animate Limbs
                if (e.mesh) {
                    e.mesh.position.set(e.x, 0, e.y);
                    e.mesh.rotation.y = -Math.atan2(dy, dx) + Math.PI / 2;
                    const stride = Math.sin(now * 0.012 * e.speed + e.phaseOffset) * 0.55;
                    if (e.mesh.userData.leftLeg) {
                        e.mesh.userData.leftLeg.rotation.x = stride;
                        e.mesh.userData.rightLeg.rotation.x = -stride;
                        e.mesh.userData.leftArm.rotation.x = -0.25 + stride * 0.35;
                        e.mesh.userData.rightArm.rotation.x = -0.25 - stride * 0.35;
                    }
                }

                // Melee Contact Damage with Player
                if (dist <= player.radius + e.radius + 4) {
                    applyDamageToPlayer(e.damage, e.x, e.y);
                    const bounce = Math.atan2(e.y - player.y, e.x - player.x);
                    e.x += Math.cos(bounce) * 18;
                    e.y += Math.sin(bounce) * 18;
                }
            }

            // Update 3D 294-Og Isotope Shard Pickups
            for (let i = shards.length - 1; i >= 0; i--) {
                const s = shards[i];
                s.pulse += 0.08;
                const d = Math.hypot(player.x - s.x, player.y - s.y);
                if (d < 165) {
                    s.x += ((player.x - s.x) / d) * 7.2;
                    s.y += ((player.y - s.y) / d) * 7.2;
                }
                if (s.mesh) {
                    s.mesh.position.set(s.x, 10 + Math.sin(s.pulse) * 3, s.y);
                    s.mesh.rotation.y += 0.06;
                }
                if (d < player.radius + s.radius + 8) {
                    player.shards += s.amount;
                    waveData.totalShardsEarned += s.amount;
                    sound.playChime(760);
                    if (s.mesh && scene3D) scene3D.remove(s.mesh);
                    shards.splice(i, 1);
                    updateHud();
                }
            }

            // Update 3D Shockwave Rings
            for (let i = shockwaveRings.length - 1; i >= 0; i--) {
                const r = shockwaveRings[i];
                r.radius += 12 * (dt / 16.67);
                r.alpha = Math.max(0, 1 - r.radius / r.maxRadius);
                if (r.mesh) {
                    const s = r.radius / 16;
                    r.mesh.scale.set(s, s, 1);
                    r.mesh.material.opacity = r.alpha;
                }
                if (r.radius >= r.maxRadius) {
                    if (r.mesh && scene3D) scene3D.remove(r.mesh);
                    shockwaveRings.splice(i, 1);
                }
            }

            // Update 3D Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx * (dt / 16.67);
                p.y += p.vy * (dt / 16.67);
                p.zHeight = Math.max(2, (p.zHeight || 20) + (p.vz || 0) * (dt / 16.67));
                p.vz = (p.vz || 0) - 0.12 * (dt / 16.67);
                p.alpha -= p.decay * (dt / 16.67);
                if (p.mesh) {
                    p.mesh.position.set(p.x, p.zHeight, p.y);
                    p.mesh.rotation.x += 0.1;
                    p.mesh.rotation.y += 0.1;
                }
                if (p.alpha <= 0) {
                    if (p.mesh && scene3D) scene3D.remove(p.mesh);
                    particles.splice(i, 1);
                }
            }

            // Update Floating Texts
            for (let i = floatingTexts.length - 1; i >= 0; i--) {
                const ft = floatingTexts[i];
                ft.y += ft.vy * (dt / 16.67);
                ft.life -= dt / 16.67;
                ft.alpha = Math.max(0, ft.life / 48);
                if (ft.life <= 0) {
                    floatingTexts.splice(i, 1);
                }
            }

            // Decay Directional Threat Indicators
            for (let i = damageDirectionalIndicators.length - 1; i >= 0; i--) {
                damageDirectionalIndicators[i].alpha -= dt * 0.0012;
                if (damageDirectionalIndicators[i].alpha <= 0) {
                    damageDirectionalIndicators.splice(i, 1);
                }
            }

            // Periodic HUD refresh for smooth bars, Radar & ECG
            updateDynamicBars(now);
            renderRadar(now);
            renderEcg(now);
        }

        // ==========================================
        // 12. RENDER PIPELINE (3D WEBGL + 2D TACTICAL VISOR OVERLAY)
        // ==========================================
        function project3DToScreen(wx, wy, wz) {
            if (!camera3D) return null;
            const vec = new THREE.Vector3(wx, wy, wz);
            vec.project(camera3D);
            if (vec.z > 1) return null; // Behind 3D camera
            return {
                x: (vec.x * 0.5 + 0.5) * canvas.width,
                y: (-(vec.y * 0.5) + 0.5) * canvas.height
            };
        }

        function renderGame(now) {
            // 1. Update & Render Three.js 3D WebGL First-Person Viewport
            if (renderer3D && scene3D && camera3D) {
                if (masterCoreGroup) {
                    masterCoreGroup.rotation.y = now * 0.0005;
                }

                if (player) {
                    // Smooth ADS Field of View Interpolation
                    const targetFov = isAds ? 50 : 75;
                    if (Math.abs(camera3D.fov - targetFov) > 0.2) {
                        camera3D.fov += (targetFov - camera3D.fov) * 0.22;
                        camera3D.updateProjectionMatrix();
                    }

                    // Head-Bob + Screen Shake in 3D Space
                    const bobY = Math.sin(player.walkBobPhase) * (isAds ? 0.45 : 1.15);
                    const bobX = Math.cos(player.walkBobPhase * 0.5) * (isAds ? 0.3 : 0.75);
                    const shakeX = (Math.random() - 0.5) * screenShake * 0.45;
                    const shakeY = (Math.random() - 0.5) * screenShake * 0.45;

                    camera3D.position.set(player.x + shakeX, EYE_HEIGHT + bobY + shakeY, player.y);
                    camera3D.rotation.y = -player.angle - Math.PI / 2;
                    camera3D.rotation.x = player.pitch + player.recoilPitch;

                    // Update First-Person 3D Weapon Viewmodel
                    weaponMeshes.forEach((m, idx) => {
                        m.visible = idx === player.weaponIndex;
                    });

                    if (weaponViewGroup) {
                        const targetX = isAds ? 0.0 : 4.2 + bobX * 0.25;
                        const targetY = isAds ? -2.35 + bobY * 0.12 : -3.6 + bobY * 0.22;
                        const targetZ = (isAds ? -6.8 : -8.5) + player.recoilKickZ;

                        weaponViewGroup.position.x += (targetX - weaponViewGroup.position.x) * 0.28;
                        weaponViewGroup.position.y += (targetY - weaponViewGroup.position.y) * 0.28;
                        weaponViewGroup.position.z += (targetZ - weaponViewGroup.position.z) * 0.35;

                        if (player.reloading) {
                            weaponViewGroup.rotation.x = -0.55;
                            weaponViewGroup.rotation.z = 0.35;
                        } else {
                            weaponViewGroup.rotation.x = player.recoilPitch * 1.4;
                            weaponViewGroup.rotation.z = 0;
                        }
                    }
                } else {
                    // Orbiting Preview Camera on Start Screen
                    const orbitAng = now * 0.00025;
                    camera3D.position.set(
                        WORLD_WIDTH / 2 + Math.cos(orbitAng) * 320,
                        85,
                        WORLD_HEIGHT / 2 + Math.sin(orbitAng) * 320
                    );
                    camera3D.lookAt(WORLD_WIDTH / 2, 35, WORLD_HEIGHT / 2);
                }

                renderer3D.render(scene3D, camera3D);
            }

            // 2. Render 2D Visor Overlay (3D Projected Health Bars, Damage Telemetry, 360° Threat Arcs & FPS Reticle)
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (!player || gameState === 'START') return;

            const cx = canvas.width / 2;
            const cy = canvas.height / 2;

            // 2A. 3D-Projected Enemy Health Bars & Target Brackets
            for (const e of enemies) {
                const dist = Math.hypot(e.x - player.x, e.y - player.y);
                if (dist > 750) continue;
                const headH = e.mesh && e.mesh.userData ? e.mesh.userData.headHeight + 10 : 44;
                const scr = project3DToScreen(e.x, headH, e.y);
                if (!scr) continue;

                if (e.hp < e.maxHp || dist < 280) {
                    const barW = Math.max(28, Math.min(68, 9500 / (dist + 60)));
                    const barH = 4.5;
                    ctx.fillStyle = "rgba(9, 14, 24, 0.85)";
                    ctx.fillRect(scr.x - barW / 2 - 1, scr.y - barH / 2 - 1, barW + 2, barH + 2);
                    ctx.fillStyle = e.color;
                    ctx.fillRect(scr.x - barW / 2, scr.y - barH / 2, barW * Math.max(0, e.hp / e.maxHp), barH);
                }
            }

            // 2B. 3D-Projected Floating Damage Numbers
            for (const ft of floatingTexts) {
                const scr = project3DToScreen(ft.x, 38 + (48 - ft.life) * 0.45, ft.y);
                if (!scr) continue;
                ctx.save();
                ctx.globalAlpha = ft.alpha;
                ctx.font = `bold ${ft.size}px 'JetBrains Mono', monospace`;
                ctx.fillStyle = ft.color;
                ctx.textAlign = "center";
                ctx.fillText(ft.text, scr.x, scr.y);
                ctx.restore();
            }

            // 2C. 3D Waypoint Indicator for Overheating QECC Node
            if (activeQeccNode) {
                const scr = project3DToScreen(activeQeccNode.x, 48, activeQeccNode.y);
                const distMeters = Math.round(Math.hypot(activeQeccNode.x - player.x, activeQeccNode.y - player.y) / 15);
                if (scr && scr.x >= 30 && scr.x <= canvas.width - 30 && scr.y >= 30 && scr.y <= canvas.height - 30) {
                    ctx.save();
                    ctx.strokeStyle = "#ff9e00";
                    ctx.lineWidth = 2;
                    ctx.strokeRect(scr.x - 14, scr.y - 14, 28, 28);
                    ctx.font = "bold 10px 'JetBrains Mono', monospace";
                    ctx.fillStyle = "#ff9e00";
                    ctx.textAlign = "center";
                    ctx.fillText(`QECC NODE [${distMeters}m]`, scr.x, scr.y - 20);
                    ctx.restore();
                } else {
                    // Edge-of-Visor Directional Arrow for Off-Screen QECC Node
                    const worldAng = Math.atan2(activeQeccNode.y - player.y, activeQeccNode.x - player.x);
                    const relAng = worldAng - player.angle;
                    const indX = cx + Math.sin(relAng) * 115;
                    const indY = cy - Math.cos(relAng) * 115;
                    ctx.save();
                    ctx.translate(indX, indY);
                    ctx.rotate(relAng);
                    ctx.fillStyle = "#ff9e00";
                    ctx.beginPath();
                    ctx.moveTo(0, -11);
                    ctx.lineTo(7, 6);
                    ctx.lineTo(-7, 6);
                    ctx.closePath();
                    ctx.fill();
                    ctx.restore();
                }
            }

            // 2D. 360° Proximity & Damage Directional Threat Arcs around Center Crosshair
            for (const e of enemies) {
                const dist = Math.hypot(e.x - player.x, e.y - player.y);
                if (dist < 240) {
                    const worldAng = Math.atan2(e.y - player.y, e.x - player.x);
                    const relAng = worldAng - player.angle;
                    if (Math.abs(Math.atan2(Math.sin(relAng), Math.cos(relAng))) > 0.65) {
                        // Host is flanking or behind player in 3D view
                        ctx.save();
                        ctx.translate(cx, cy);
                        ctx.rotate(relAng - Math.PI / 2);
                        ctx.strokeStyle = `rgba(255, 42, 84, ${(1 - dist / 240) * 0.65})`;
                        ctx.lineWidth = 3.5;
                        ctx.beginPath();
                        ctx.arc(0, 0, 68, -0.22, 0.22);
                        ctx.stroke();
                        ctx.restore();
                    }
                }
            }

            for (const dmgInd of damageDirectionalIndicators) {
                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(dmgInd.angle - Math.PI / 2);
                ctx.strokeStyle = `rgba(255, 42, 84, ${dmgInd.alpha})`;
                ctx.lineWidth = 6;
                ctx.beginPath();
                ctx.arc(0, 0, 82, -0.35, 0.35);
                ctx.stroke();
                ctx.restore();
            }

            // 2E. First-Person Center Tactical Crosshair, ADS Optic & Hitmarkers
            const activeWep = weapons[player.weaponIndex];
            const spreadGap = (isAds ? 4 : 8) + activeWep.spread * (isAds ? 18 : 42) + player.recoilBloom;

            ctx.save();
            ctx.translate(cx, cy);

            if (isAds) {
                // ADS Precision Holographic Sight Ring
                ctx.strokeStyle = "rgba(0, 240, 255, 0.38)";
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.arc(0, 0, 44, 0, Math.PI * 2);
                ctx.stroke();
            }

            // Center Precision Dot
            ctx.fillStyle = activeWep.color;
            ctx.beginPath();
            ctx.arc(0, 0, 2.2, 0, Math.PI * 2);
            ctx.fill();

            // Dynamic 4-Axis Reticle Ticks
            ctx.strokeStyle = activeWep.color;
            ctx.lineWidth = 2;
            const tickLen = isAds ? 9 : 7;
            ctx.beginPath();
            ctx.moveTo(0, -spreadGap); ctx.lineTo(0, -spreadGap - tickLen);
            ctx.moveTo(0, spreadGap);  ctx.lineTo(0, spreadGap + tickLen);
            ctx.moveTo(-spreadGap, 0); ctx.lineTo(-spreadGap - tickLen, 0);
            ctx.moveTo(spreadGap, 0);  ctx.lineTo(spreadGap + tickLen, 0);
            ctx.stroke();

            // Reload Progress Ring around Center Reticle
            if (player.reloading) {
                const progress = Math.min(1, (now - player.reloadStartTime) / activeWep.reloadTime);
                ctx.strokeStyle = "rgba(15, 23, 42, 0.75)";
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.arc(0, 0, 26, 0, Math.PI * 2);
                ctx.stroke();

                ctx.strokeStyle = "#00f0ff";
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.arc(0, 0, 26, -Math.PI / 2, -Math.PI / 2 + progress * Math.PI * 2);
                ctx.stroke();
            }

            // X-Hitmarker Flash on Host Impact / Critical / Neutralization
            if (player.hitmarkerTimer > 0) {
                ctx.strokeStyle = player.hitmarkerKill ? "#ff2a54" : player.hitmarkerCrit ? "#fbbf24" : "#00f0ff";
                ctx.lineWidth = player.hitmarkerKill ? 2.8 : 2.0;
                const hmInner = 5;
                const hmOuter = player.hitmarkerKill ? 15 : 11;
                ctx.beginPath();
                ctx.moveTo(-hmInner, -hmInner); ctx.lineTo(-hmOuter, -hmOuter);
                ctx.moveTo(hmInner, -hmInner);  ctx.lineTo(hmOuter, -hmOuter);
                ctx.moveTo(-hmInner, hmInner);  ctx.lineTo(-hmOuter, hmOuter);
                ctx.moveTo(hmInner, hmInner);   ctx.lineTo(hmOuter, hmOuter);
                ctx.stroke();
            }

            ctx.restore();
        }

