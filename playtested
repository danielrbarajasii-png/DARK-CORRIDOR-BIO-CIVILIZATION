    <script>
        /**
         * DARK CORRIDOR: BIO-CIVILIZATION — PRE-WAR CONTAINMENT BREACH (OUTBREAK ZERO)
         * Complete Top-Down 2D Tactical Survival Shooter Engine
         */

        // ==========================================
        // 1. WEB AUDIO API PROCEDURAL SYNTHESIZER
        // ==========================================
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            toggleMute() {
                this.muted = !this.muted;
                return this.muted;
            }

            playGunshot(weaponId) {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    // Noise burst for percussive punch
                    const bufferSize = this.ctx.sampleRate * 0.12;
                    const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                    const output = noiseBuffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                        output[i] = Math.random() * 2 - 1;
                    }
                    const whiteNoise = this.ctx.createBufferSource();
                    whiteNoise.buffer = noiseBuffer;

                    const filter = this.ctx.createBiquadFilter();
                    filter.type = 'bandpass';

                    const noiseGain = this.ctx.createGain();

                    if (weaponId === 0) {
                        // Tactical Sidearm: crisp punch
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(260, now);
                        osc.frequency.exponentialRampToValueAtTime(55, now + 0.09);
                        gain.gain.setValueAtTime(0.22, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

                        filter.frequency.setValueAtTime(1200, now);
                        noiseGain.gain.setValueAtTime(0.18, now);
                        noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                    } else if (weaponId === 1) {
                        // Pulse SMG: high-tech plasma zip
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(520, now);
                        osc.frequency.exponentialRampToValueAtTime(110, now + 0.065);
                        gain.gain.setValueAtTime(0.16, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.065);

                        filter.frequency.setValueAtTime(2200, now);
                        noiseGain.gain.setValueAtTime(0.1, now);
                        noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                    } else if (weaponId === 2) {
                        // Breacher 12G Shotgun: heavy low boom
                        osc.type = 'square';
                        osc.frequency.setValueAtTime(150, now);
                        osc.frequency.exponentialRampToValueAtTime(32, now + 0.22);
                        gain.gain.setValueAtTime(0.32, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

                        filter.frequency.setValueAtTime(650, now);
                        noiseGain.gain.setValueAtTime(0.35, now);
                        noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                    } else {
                        // Lie-Bus Rail Carbine: hyper-velocity resonant crack
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(980, now);
                        osc.frequency.exponentialRampToValueAtTime(75, now + 0.26);
                        gain.gain.setValueAtTime(0.3, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.26);

                        filter.frequency.setValueAtTime(3000, now);
                        noiseGain.gain.setValueAtTime(0.25, now);
                        noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
                    }

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.28);

                    whiteNoise.connect(filter);
                    filter.connect(noiseGain);
                    noiseGain.connect(this.ctx.destination);
                    whiteNoise.start(now);
                    whiteNoise.stop(now + 0.12);
                } catch (e) {}
            }

            playReload() {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(580, now);
                    osc.frequency.setValueAtTime(840, now + 0.08);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.18);
                } catch (e) {}
            }

            playShockwave() {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(420, now);
                    osc.frequency.exponentialRampToValueAtTime(42, now + 0.55);
                    gain.gain.setValueAtTime(0.38, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.56);
                } catch (e) {}
            }

            playHit(isKill = false) {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = isKill ? 'sawtooth' : 'triangle';
                    osc.frequency.setValueAtTime(isKill ? 180 : 130, now);
                    osc.frequency.exponentialRampToValueAtTime(45, now + 0.08);
                    gain.gain.setValueAtTime(isKill ? 0.16 : 0.09, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.09);
                } catch (e) {}
            }

            playChime(freq = 660) {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now);
                    osc.frequency.exponentialRampToValueAtTime(freq * 1.4, now + 0.22);
                    gain.gain.setValueAtTime(0.14, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } catch (e) {}
            }
        }

        const sound = new SoundEngine();

        // ==========================================
        // 1B. MOBILE APP SHELL: HAPTICS, GYROSCOPE, PWA & CAREER STORAGE
        // ==========================================
        class HapticEngine {
            constructor() {
                this.enabled = true;
            }
            pulse(pattern) {
                if (!this.enabled) return;
                try {
                    if (navigator.vibrate) {
                        navigator.vibrate(pattern);
                    }
                } catch (e) {}
            }
            gunshot(weaponId) {
                if (weaponId === 0) this.pulse(12);
                else if (weaponId === 1) this.pulse(8);
                else if (weaponId === 2) this.pulse([28, 20, 18]);
                else this.pulse([35, 15, 25]);
            }
            damage() {
                this.pulse([60, 30, 60]);
            }
            shockwave() {
                this.pulse([45, 25, 80]);
            }
        }

        const haptics = new HapticEngine();

        // Persistent Career Telemetry & Settings in localStorage
        const STORAGE_KEY = 'DARK_CORRIDOR_OUTBREAK_ZERO_SAVE_V1';
        let careerData = {
            bestWave: 1,
            totalKills: 0,
            totalNodes: 0,
            lookSensitivity: 1.0,
            autoFire: true,
            aimAssist: true,
            haptics: true
        };

        function loadCareerProfile() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    careerData = { ...careerData, ...parsed };
                }
            } catch (e) {}
            lookSensitivity = careerData.lookSensitivity || 1.0;
            autoFireEnabled = careerData.autoFire !== false;
            aimAssistEnabled = careerData.aimAssist !== false;
            haptics.enabled = careerData.haptics !== false;

            const sensSlider = document.getElementById('sliderLookSens');
            if (sensSlider) sensSlider.value = Math.round(lookSensitivity * 100);
            updateCareerUi();
        }

        function saveCareerProfile() {
            try {
                if (waveData.waveNumber > careerData.bestWave) {
                    careerData.bestWave = waveData.waveNumber;
                }
                careerData.lookSensitivity = lookSensitivity;
                careerData.autoFire = autoFireEnabled;
                careerData.aimAssist = aimAssistEnabled;
                careerData.haptics = haptics.enabled;
                localStorage.setItem(STORAGE_KEY, JSON.stringify(careerData));
            } catch (e) {}
            updateCareerUi();
        }

        function updateCareerUi() {
            const bw = document.getElementById('careerBestWave');
            const tk = document.getElementById('careerTotalKills');
            const tn = document.getElementById('careerTotalNodes');
            if (bw) bw.textContent = String(careerData.bestWave).padStart(2, '0');
            if (tk) tk.textContent = careerData.totalKills;
            if (tn) tn.textContent = careerData.totalNodes;
        }

        // Gyroscope Tilt-Aiming Controller
        let gyroEnabled = false;
        let lastGyroBeta = null;
        let lastGyroGamma = null;

        async function toggleGyroscope() {
            if (!gyroEnabled) {
                if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                    try {
                        const perm = await DeviceOrientationEvent.requestPermission();
                        if (perm !== 'granted') return;
                    } catch (e) {
                        return;
                    }
                }
                gyroEnabled = true;
                lastGyroBeta = null;
                lastGyroGamma = null;
            } else {
                gyroEnabled = false;
            }
            const lbl = document.getElementById('lblGyro');
            const btn = document.getElementById('btnToggleGyro');
            if (lbl) lbl.textContent = gyroEnabled ? "ON" : "OFF";
            if (btn) {
                btn.className = gyroEnabled
                    ? "fps-touch-btn chamfer-sm px-2 py-1 bg-purple-500/25 border border-purple-400/70 text-purple-300 font-mono-tech text-[9px] sm:text-[10px] font-bold flex items-center gap-1"
                    : "fps-touch-btn chamfer-sm px-2 py-1 bg-slate-900/85 border border-slate-700 text-slate-400 font-mono-tech text-[9px] sm:text-[10px] font-bold flex items-center gap-1";
            }
        }

        window.addEventListener('deviceorientation', (e) => {
            if (!gyroEnabled || gameState !== 'PLAYING' || !player) return;
            if (e.gamma === null || e.beta === null) return;
            if (lastGyroGamma !== null && lastGyroBeta !== null) {
                const dGamma = e.gamma - lastGyroGamma;
                const dBeta = e.beta - lastGyroBeta;
                if (Math.abs(dGamma) < 25 && Math.abs(dBeta) < 25) {
                    const isLandscape = window.innerWidth > window.innerHeight;
                    const yawDelta = isLandscape ? dBeta : dGamma;
                    const pitchDelta = isLandscape ? -dGamma : dBeta;
                    player.angle += yawDelta * 0.011 * lookSensitivity;
                    player.pitch = Math.max(-0.62, Math.min(0.62, player.pitch - pitchDelta * 0.008 * lookSensitivity));
                }
            }
            lastGyroGamma = e.gamma;
            lastGyroBeta = e.beta;
        });

        // Fullscreen & Landscape Orientation Lock Helper
        async function requestMobileFullscreenAndLandscape() {
            try {
                const docEl = document.documentElement;
                if (!document.fullscreenElement) {
                    if (docEl.requestFullscreen) await docEl.requestFullscreen();
                    else if (docEl.webkitRequestFullscreen) docEl.webkitRequestFullscreen();
                } else {
                    if (document.exitFullscreen) await document.exitFullscreen();
                }
                if (screen.orientation && screen.orientation.lock) {
                    await screen.orientation.lock('landscape').catch(() => {});
