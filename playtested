                    bpmEl.className = "text-emerald-400 font-bold";
                    bioEl.textContent = "MITOSIS LOCK: STABLE";
                    bioEl.className = "text-[10px] font-mono-tech text-cyan-300 truncate";
                }
            }

            // Reload Bar Update
            const reloadContainer = document.getElementById('hudReloadBarContainer');
            const reloadBar = document.getElementById('hudReloadBar');
            if (reloadContainer && reloadBar) {
                if (player.reloading) {
                    reloadContainer.classList.remove('hidden');
                    const activeWep = weapons[player.weaponIndex];
                    const pct = Math.min(100, ((now - player.reloadStartTime) / activeWep.reloadTime) * 100);
                    reloadBar.style.width = `${pct}%`;
                } else {
                    reloadContainer.classList.add('hidden');
                }
            }
        }

