    <style>
        :root {
            --corridor-bg: #05070a;
            --corridor-panel: rgba(8, 13, 22, 0.88);
            --corridor-cyan: #00f0ff;
            --corridor-amber: #ff9e00;
            --corridor-crimson: #ff2a54;
            --corridor-emerald: #10b981;
            --corridor-purple: #c084fc;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--corridor-bg);
            font-family: 'Inter', sans-serif;
            color: #e2e8f0;
        }

        .font-display {
            font-family: 'Orbitron', sans-serif;
        }

        .font-mono-tech {
            font-family: 'JetBrains Mono', monospace;
        }

        /* CRT, Hex-Grid & Scanline Visor Overlays */
        .scanlines {
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.28) 50%,
                rgba(0, 0, 0, 0.28)
            );
            background-size: 100% 4px;
            pointer-events: none;
        }

        .visor-grid {
            background-image: 
                radial-gradient(rgba(0, 240, 255, 0.06) 1px, transparent 1px),
                linear-gradient(to right, rgba(0, 240, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 240, 255, 0.02) 1px, transparent 1px);
            background-size: 28px 28px, 56px 56px, 56px 56px;
            pointer-events: none;
        }

        .vignette {
            box-shadow: inset 0 0 130px rgba(0, 0, 0, 0.88), inset 0 0 35px rgba(0, 240, 255, 0.08);
            pointer-events: none;
        }

        .damage-vignette {
            box-shadow: inset 0 0 160px rgba(255, 20, 50, 0.72);
            pointer-events: none;
            transition: opacity 0.18s ease-out;
        }

        /* Chamfered Military-Sci-Fi Clip Paths */
        .chamfer-panel {
            clip-path: polygon(
                0 12px,
                12px 0,
                calc(100% - 16px) 0,
                100% 16px,
                100% calc(100% - 12px),
                calc(100% - 12px) 100%,
                16px 100%,
                0 calc(100% - 16px)
            );
        }

        .chamfer-sm {
            clip-path: polygon(
                0 7px,
                7px 0,
                calc(100% - 9px) 0,
                100% 9px,
                100% calc(100% - 7px),
                calc(100% - 7px) 100%,
                9px 100%,
                0 calc(100% - 9px)
            );
        }

        /* Slanted Telemetry Progress Bars */
        .skew-bar {
            transform: skewX(-18deg);
        }

        /* Tactical HUD Borders and Glows */
        .tech-panel {
            position: relative;
            background: linear-gradient(145deg, rgba(11, 18, 30, 0.92) 0%, rgba(6, 10, 18, 0.90) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 240, 255, 0.25);
            box-shadow: 0 6px 28px rgba(0, 0, 0, 0.75), inset 0 0 18px rgba(0, 240, 255, 0.06);
        }

        .tech-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 28px;
            height: 2px;
            background: var(--corridor-cyan);
            box-shadow: 0 0 8px var(--corridor-cyan);
            pointer-events: none;
        }

        .tech-panel-amber {
            position: relative;
            background: linear-gradient(145deg, rgba(22, 16, 10, 0.92) 0%, rgba(10, 8, 6, 0.90) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 158, 0, 0.4);
            box-shadow: 0 6px 28px rgba(0, 0, 0, 0.75), inset 0 0 18px rgba(255, 158, 0, 0.08);
        }

        .tech-panel-crimson {
            position: relative;
            background: linear-gradient(145deg, rgba(24, 8, 15, 0.94) 0%, rgba(12, 5, 9, 0.92) 100%);
