        document.getElementById('btnInstallPwaStart').addEventListener('click', async () => {
            if (!deferredPwaPrompt) return;
            deferredPwaPrompt.prompt();
            await deferredPwaPrompt.userChoice;
            deferredPwaPrompt = null;
            document.getElementById('btnInstallPwaStart').classList.add('hidden');
        });

        // ==========================================
        // 15. MASTER ANIMATION LOOP & FPS TELEMETRY
        // ==========================================
        let fpsFrames = 0;
        let fpsLastSample = performance.now();

        function gameLoop(now) {
            const dt = Math.min(50, now - lastFrameTime);
            lastFrameTime = now;

            fpsFrames++;
            if (now - fpsLastSample >= 500) {
                const currentFps = Math.min(120, Math.round((fpsFrames * 1000) / (now - fpsLastSample)));
                const fpsEl = document.getElementById('hudFpsCounter');
                if (fpsEl) fpsEl.textContent = `${currentFps} FPS`;
                fpsFrames = 0;
                fpsLastSample = now;
            }

            updateGame(dt, now);
            renderGame(now);

            requestAnimationFrame(gameLoop);
        }

        window.onload = function () {
            initMobilePwaShell();
            loadCareerProfile();
            initThreeScene();
            buildSubLevel09Layout();
            rebuild3DFacilityGeometry();
            if (window.innerWidth < 640) {
                document.body.classList.add('compact-mobile-hud');
            }
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
