        function updateLeftStick(clientX, clientY) {
            const dx = clientX - touchControls.moveOriginX;
            const dy = clientY - touchControls.moveOriginY;
            const maxR = 46;
            const dist = Math.min(maxR, Math.hypot(dx, dy));
            const ang = Math.atan2(dy, dx);
            touchControls.moveDx = (Math.cos(ang) * dist) / maxR;
            touchControls.moveDy = (Math.sin(ang) * dist) / maxR;
            moveKnob.style.transform = `translate(${Math.cos(ang) * dist}px, ${Math.sin(ang) * dist}px)`;

            const sprintBadge = document.getElementById('sprintLatchBadge');
            if (sprintBadge) {
                if (touchControls.moveDy < -0.78) {
                    sprintBadge.classList.remove('hidden');
                } else {
                    sprintBadge.classList.add('hidden');
                }
            }
        }

        function resetMoveStick() {
            touchControls.moveActive = false;
            touchControls.moveId = null;
            touchControls.moveDx = 0;
            touchControls.moveDy = 0;
            moveKnob.style.transform = `translate(0px, 0px)`;
            moveZone.style.transform = `translate(0px, 0px)`;
            const sprintBadge = document.getElementById('sprintLatchBadge');
            if (sprintBadge) sprintBadge.classList.add('hidden');
        }

        // Left Fixed Stick Zone Touch
        moveZone.addEventListener('touchstart', (e) => {
            e.preventDefault();
            e.stopPropagation();
            sound.init();
            const t = e.changedTouches[0];
            const rect = moveZone.getBoundingClientRect();
            touchControls.moveActive = true;
            touchControls.moveId = t.identifier;
            touchControls.moveOriginX = rect.left + rect.width / 2;
            touchControls.moveOriginY = rect.top + rect.height / 2;
            updateLeftStick(t.clientX, t.clientY);
        }, { passive: false });

        moveZone.addEventListener('touchmove', (e) => {
            e.preventDefault();
            e.stopPropagation();
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                if (t.identifier === touchControls.moveId) {
                    updateLeftStick(t.clientX, t.clientY);
                }
            }
        }, { passive: false });

        moveZone.addEventListener('touchend', (e) => {
            for (let i = 0; i < e.changedTouches.length; i++) {
                if (e.changedTouches[i].identifier === touchControls.moveId) resetMoveStick();
            }
        });
        moveZone.addEventListener('touchcancel', resetMoveStick);

        // Right Dedicated FIRE Button + Drag-to-Aim Support
        aimZone.addEventListener('touchstart', (e) => {
            e.preventDefault();
            e.stopPropagation();
            sound.init();
            const t = e.changedTouches[0];
            const rect = aimZone.getBoundingClientRect();
            touchControls.aimActive = true;
            touchControls.aimId = t.identifier;
            touchControls.aimOriginX = rect.left + rect.width / 2;
            touchControls.aimOriginY = rect.top + rect.height / 2;
            touchControls.aimLastX = t.clientX;
            touchControls.aimLastY = t.clientY;
            aimKnob.classList.add('scale-90');
        }, { passive: false });

        aimZone.addEventListener('touchmove', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (!touchControls.aimActive || !player) return;
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                if (t.identifier === touchControls.aimId) {
                    const deltaX = t.clientX - touchControls.aimLastX;
                    const deltaY = t.clientY - touchControls.aimLastY;
                    touchControls.aimLastX = t.clientX;
                    touchControls.aimLastY = t.clientY;

                    const sens = 0.0052 * lookSensitivity * (isAds ? 0.65 : 1.0);
                    player.angle += deltaX * sens;
                    player.pitch = Math.max(-0.62, Math.min(0.62, player.pitch - deltaY * sens * 0.8));

                    const dx = t.clientX - touchControls.aimOriginX;
                    const dy = t.clientY - touchControls.aimOriginY;
                    const dist = Math.min(24, Math.hypot(dx, dy));
                    const ang = Math.atan2(dy, dx);
                    aimKnob.style.transform = `translate(${Math.cos(ang) * dist}px, ${Math.sin(ang) * dist}px)`;
                }
            }
        }, { passive: false });

        const resetAimStick = (e) => {
            if (e && e.changedTouches) {
                for (let i = 0; i < e.changedTouches.length; i++) {
                    if (e.changedTouches[i].identifier === touchControls.aimId) {
                        touchControls.aimActive = false;
                        touchControls.aimId = null;
                        aimKnob.style.transform = `translate(0px, 0px)`;
                        aimKnob.classList.remove('scale-90');
                    }
                }
            } else {
        // Fullscreen Multi-Touch Gesture Layer (Left Half Floating Stick + Right Half 3D Free-Look Touchpad + Double-Tap ADS)
        let lastRightScreenTapTime = 0;

        fpsTouchLayer.addEventListener('touchstart', (e) => {
            if (gameState !== 'PLAYING' || !player) return;
            e.preventDefault();
            sound.init();
            const now = performance.now();
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                if (t.clientX < window.innerWidth * 0.45 && !touchControls.moveActive) {
                    // Spawn Dynamic Left Locomotion Stick at Thumb Position
                    touchControls.moveActive = true;
                    touchControls.moveId = t.identifier;
                    touchControls.moveOriginX = t.clientX;
                    touchControls.moveOriginY = t.clientY;
                    touchControls.moveDx = 0;
                    touchControls.moveDy = 0;
