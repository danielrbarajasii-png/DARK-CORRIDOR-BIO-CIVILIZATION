        function renderRadar(now) {
            if (!radarCtx || !player) return;
            const w = radarCanvas.width;
            const h = radarCanvas.height;
            const cx = w / 2;
            const cy = h / 2;
            const radarRange = 900; // World units mapped to radar radius
            const scale = (w / 2) / radarRange;

            radarCtx.clearRect(0, 0, w, h);

            // Radar Background Grid & Concentric Rings
            radarCtx.fillStyle = "rgba(4, 9, 16, 0.94)";
            radarCtx.fillRect(0, 0, w, h);

            radarCtx.strokeStyle = "rgba(0, 240, 255, 0.16)";
            radarCtx.lineWidth = 1;
            [20, 40, 58].forEach(r => {
                radarCtx.beginPath();
                radarCtx.arc(cx, cy, r, 0, Math.PI * 2);
                radarCtx.stroke();
            });

            // Crosshair Axes
            radarCtx.beginPath();
            radarCtx.moveTo(0, cy); radarCtx.lineTo(w, cy);
            radarCtx.moveTo(cx, 0); radarCtx.lineTo(cx, h);
            radarCtx.stroke();

            // Facility Obstacles relative to player
            radarCtx.fillStyle = "rgba(51, 65, 85, 0.7)";
            for (const obs of obstacles) {
                const rx = cx + (obs.x - player.x) * scale;
                const ry = cy + (obs.y - player.y) * scale;
                const rw = obs.w * scale;
                const rh = obs.h * scale;
                radarCtx.fillRect(rx, ry, rw, rh);
            }

            // Rotating LiDAR Sweep Beam
            const sweepAngle = (now * 0.0028) % (Math.PI * 2);
            radarCtx.save();
            radarCtx.translate(cx, cy);
            radarCtx.rotate(sweepAngle);
            const sweepGrad = radarCtx.createLinearGradient(0, 0, 60, 0);
            sweepGrad.addColorStop(0, "rgba(0, 240, 255, 0.32)");
            sweepGrad.addColorStop(1, "rgba(0, 240, 255, 0)");
            radarCtx.fillStyle = sweepGrad;
            radarCtx.beginPath();
            radarCtx.moveTo(0, 0);
            radarCtx.arc(0, 0, 62, 0, 0.55);
            radarCtx.closePath();
            radarCtx.fill();
            radarCtx.restore();

            // Active Overheating QECC Node Blip
            if (activeQeccNode) {
                const nx = cx + (activeQeccNode.x - player.x) * scale;
                const ny = cy + (activeQeccNode.y - player.y) * scale;
                const clampedDist = Math.min(56, Math.hypot(nx - cx, ny - cy));
                const ang = Math.atan2(ny - cy, nx - cx);
                const bx = cx + Math.cos(ang) * clampedDist;
                const by = cy + Math.sin(ang) * clampedDist;

                radarCtx.fillStyle = "#ff9e00";
                radarCtx.beginPath();
                radarCtx.arc(bx, by, 4, 0, Math.PI * 2);
                radarCtx.fill();
            }

            // Automated Sentries Blips
            for (const t of turrets) {
                const tx = cx + (t.x - player.x) * scale;
                const ty = cy + (t.y - player.y) * scale;
                if (Math.hypot(tx - cx, ty - cy) < 58) {
                    radarCtx.fillStyle = "#10b981";
                    radarCtx.fillRect(tx - 2, ty - 2, 4, 4);
                }
            }

            // Decohered Host Blips
            for (const e of enemies) {
                const ex = cx + (e.x - player.x) * scale;
                const ey = cy + (e.y - player.y) * scale;
                const dist = Math.hypot(ex - cx, ey - cy);
                if (dist < 59) {
                    radarCtx.fillStyle = e.color;
                    radarCtx.beginPath();
                    radarCtx.arc(ex, ey, e.type === 'juggernaut' ? 3.2 : 2.2, 0, Math.PI * 2);
                    radarCtx.fill();
                }
            }

            // Player Center Directional Cone
            radarCtx.save();
            radarCtx.translate(cx, cy);
            radarCtx.rotate(player.angle);
            radarCtx.fillStyle = "rgba(0, 240, 255, 0.22)";
            radarCtx.beginPath();
            radarCtx.moveTo(0, 0);
            radarCtx.arc(0, 0, 22, -0.45, 0.45);
            radarCtx.closePath();
            radarCtx.fill();

            radarCtx.fillStyle = "#ffffff";
            radarCtx.beginPath();
            radarCtx.arc(0, 0, 2.8, 0, Math.PI * 2);
            radarCtx.fill();
            radarCtx.restore();

            const coordEl = document.getElementById('hudRadarCoords');
            if (coordEl) {
                coordEl.textContent = `${Math.round(player.x)},${Math.round(player.y)}`;
            }
        }

        function renderEcg(now) {
            if (!ecgCtx || !player) return;
            const w = ecgCanvas.width;
            const h = ecgCanvas.height;
            const hpRatio = player.hp / player.maxHp;

            // Advance ECG Phase faster when Suit Integrity drops
            const speed = hpRatio < 0.35 ? 0.28 : hpRatio < 0.65 ? 0.19 : 0.13;
            ecgPhase += speed;

            let yVal = h / 2;
            const cycle = ecgPhase % (Math.PI * 2);
            if (cycle > 2.2 && cycle < 2.5) {
                yVal = h / 2 - 4; // P wave
            } else if (cycle >= 2.7 && cycle < 2.95) {
                yVal = h / 2 + 5; // Q dip
            } else if (cycle >= 2.95 && cycle < 3.25) {
                yVal = 3; // R spike
            } else if (cycle >= 3.25 && cycle < 3.5) {
                yVal = h - 3; // S dip
            } else if (cycle >= 3.8 && cycle < 4.3) {
                yVal = h / 2 - 5; // T wave
            }

            ecgPoints.push(yVal);
            if (ecgPoints.length > 55) ecgPoints.shift();

            ecgCtx.clearRect(0, 0, w, h);
            const strokeColor = hpRatio < 0.35 ? "#ff2a54" : hpRatio < 0.65 ? "#ff9e00" : "#10b981";
            ecgCtx.strokeStyle = strokeColor;
            ecgCtx.lineWidth = 1.6;
            ecgCtx.beginPath();
            for (let i = 0; i < ecgPoints.length; i++) {
                const px = (i / (ecgPoints.length - 1)) * w;
                const py = ecgPoints[i];
                if (i === 0) ecgCtx.moveTo(px, py);
                else ecgCtx.lineTo(px, py);
            }
            ecgCtx.stroke();
        }

        function updateDynamicBars(now = performance.now()) {
