        function fireCurrentWeapon(now) {
            if (!player || player.reloading) return;
            const wep = weapons[player.weaponIndex];
            if (now - player.lastShotTime < wep.fireRate) return;

            if (wep.currentMag <= 0) {
                startReload(now);
                return;
            }

            player.lastShotTime = now;
            wep.currentMag--;
            const adsSpreadMult = isAds ? 0.42 : 1.0;
            player.recoilBloom = Math.min(26, player.recoilBloom + (wep.id >= 2 ? 10 : 4.2) * adsSpreadMult);
            player.recoilKickZ = Math.min(3.2, player.recoilKickZ + (wep.id >= 2 ? 2.1 : 0.95));
            player.recoilPitch = Math.min(0.12, player.recoilPitch + (wep.id >= 2 ? 0.042 : 0.014));
            sound.playGunshot(wep.id);
            haptics.gunshot(wep.id);

            // 3D Muzzle Flash Trigger
            if (muzzleFlashLight && muzzleFlashMesh) {
                muzzleFlashLight.color.set(wep.color);
                muzzleFlashLight.intensity = 3.2;
                muzzleFlashMesh.visible = true;
                muzzleFlashMesh.rotation.z = Math.random() * Math.PI;
            }

            // Muzzle World Coordinates
            const muzzleX = player.x + Math.cos(player.angle) * 22;
            const muzzleY = player.y + Math.sin(player.angle) * 22;
            const muzzleHeight = EYE_HEIGHT - 4 + Math.sin(player.pitch) * 18;

            // Check if aiming at upper head zone for Critical Headshot bonus (1.5x)
            const isHeadshotAim = player.pitch > -0.06 && player.pitch < 0.22;

            // Spawn 3D Tracer Projectiles
            const tracerColor = new THREE.Color(wep.color);
            for (let i = 0; i < wep.pellets; i++) {
                const spreadAngle = player.angle + (Math.random() - 0.5) * wep.spread * adsSpreadMult;
                const spreadPitch = player.pitch + (Math.random() - 0.5) * wep.spread * 0.5 * adsSpreadMult;

                let tracerMesh = null;
                if (scene3D) {
                    const geo = new THREE.BoxGeometry(wep.id === 3 ? 0.9 : 0.45, wep.id === 3 ? 0.9 : 0.45, wep.id === 3 ? 18 : 9);
                    const mat = new THREE.MeshBasicMaterial({ color: tracerColor });
                    tracerMesh = new THREE.Mesh(geo, mat);
                    tracerMesh.position.set(muzzleX, muzzleHeight, muzzleY);
                    tracerMesh.rotation.y = -spreadAngle + Math.PI / 2;
                    scene3D.add(tracerMesh);
                }

                bullets.push({
                    x: muzzleX,
                    y: muzzleY,
                    zHeight: muzzleHeight,
                    vx: Math.cos(spreadAngle) * wep.bulletSpeed * 1.35,
                    vy: Math.sin(spreadAngle) * wep.bulletSpeed * 1.35,
                    vz: Math.sin(spreadPitch) * wep.bulletSpeed * 1.1,
                    damage: wep.damage,
                    isHeadshotCapable: isHeadshotAim,
                    pierce: wep.pierce,
                    knockback: wep.knockback,
                    color: wep.color,
                    isRail: wep.id === 3,
                    hitIds: new Set(),
                    life: 65,
                    mesh: tracerMesh
                });
            }

            screenShake = Math.min(screenShake + (wep.id >= 2 ? 4.0 : 1.4), 9);

            if (wep.currentMag === 0 && wep.reserveAmmo > 0) {
                startReload(now);
            }
            updateHud();
        }

        function startReload(now = performance.now()) {
            if (!player || player.reloading) return;
            const wep = weapons[player.weaponIndex];
            if (wep.currentMag >= wep.magSize || wep.reserveAmmo <= 0) return;

            player.reloading = true;
            player.reloadStartTime = now;
            sound.playReload();
            addFloatingText(player.x, player.y - 26, "RELOADING...", "#38bdf8", 11);
            updateHud();
        }

        function triggerQeccShockwave() {
            if (!player || player.shockwaveCooldown > 0) return;

            player.shockwaveCooldown = player.shockwaveMaxCooldown;
            sound.playShockwave();
            haptics.shockwave();
            screenShake = 11;

            let ringMesh = null;
            if (scene3D) {
                ringMesh = new THREE.Mesh(
                    new THREE.RingGeometry(12, 20, 36),
                    new THREE.MeshBasicMaterial({ color: 0x00f0ff, side: THREE.DoubleSide, transparent: true, opacity: 0.9 })
                );
                ringMesh.rotation.x = -Math.PI / 2;
                ringMesh.position.set(player.x, 4, player.y);
                scene3D.add(ringMesh);
            }

            shockwaveRings.push({
                x: player.x,
                y: player.y,
                radius: 20,
                maxRadius: 270,
                alpha: 1,
                mesh: ringMesh
            });

            // Damage and knock back all nearby Decohered Hosts
            const blastRadius = 270;
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                const dx = e.x - player.x;
                const dy = e.y - player.y;
                const dist = Math.hypot(dx, dy);
                if (dist < blastRadius) {
                    const falloff = 1 - (dist / blastRadius) * 0.5;
                    const dmg = Math.round(65 * falloff);
                    e.hp -= dmg;
                    const pushAngle = Math.atan2(dy, dx);
                    e.x += Math.cos(pushAngle) * 75 * falloff;
                    e.y += Math.sin(pushAngle) * 75 * falloff;
                    e.stunTimer = 400;
                    addFloatingText(e.x, e.y - e.radius, `-${dmg} QECC`, "#fbbf24", 13);
                    spawnParticles(e.x, e.y, "#00f0ff", 8, 4, 3);
                    if (e.hp <= 0) {
                        handleEnemyDeath(e, i);
                    }
                }
            }

            addFloatingText(player.x, player.y - 32, "QECC LATTICE SHOCKWAVE!", "#00f0ff", 14);
            updateHud();
        }

        // ==========================================
        // 9. ENEMY SPAWNING & AI (DECOHERED HOSTS)
        // ==========================================
        function spawnEnemy() {
            const diff = DIFFICULTY_PRESETS[selectedDifficulty];
            const waveScale = 1 + (waveData.waveNumber - 1) * 0.14;

            // Pick spawn point outside player's immediate screen view but inside facility
            let sx = 0, sy = 0;
            for (let attempt = 0; attempt < 15; attempt++) {
                const angle = Math.random() * Math.PI * 2;
                const dist = 580 + Math.random() * 340;
                sx = Math.max(100, Math.min(WORLD_WIDTH - 100, player.x + Math.cos(angle) * dist));
                sy = Math.max(100, Math.min(WORLD_HEIGHT - 100, player.y + Math.sin(angle) * dist));

                let insideWall = false;
                for (const obs of obstacles) {
                    if (circleRectCollide(sx, sy, 28, obs.x, obs.y, obs.w, obs.h)) {
                        insideWall = true;
                        break;
                    }
                }
                if (!insideWall) break;
            }

            // Determine Host Class based on Wave Number
            const roll = Math.random();
            let type = 'infected';
            if (waveData.waveNumber >= 2 && roll > 0.68) type = 'stalker';
            if (waveData.waveNumber >= 3 && roll > 0.84) type = 'spitter';
            if (waveData.waveNumber >= 3 && roll > 0.93) type = 'juggernaut';

            let hostConfig = {
                id: Math.random().toString(36).substring(2),
                x: sx,
                y: sy,
                type,
                stunTimer: 0,
                phaseOffset: Math.random() * Math.PI * 2,
                attackCooldown: 0
            };

            if (type === 'infected') {
                hostConfig.name = "Lab Infected";
                hostConfig.radius = 16;
                hostConfig.hp = Math.round(52 * waveScale * diff.enemyHpMult);
                hostConfig.maxHp = hostConfig.hp;
                hostConfig.speed = (2.1 + Math.random() * 0.45) * diff.enemySpeedMult;
                hostConfig.damage = Math.round(14 * diff.enemyDmgMult);
                hostConfig.color = "#f43f5e";
                hostConfig.shardDrop = 3;
            } else if (type === 'stalker') {
                hostConfig.name = "Phase-Stalker";
                hostConfig.radius = 14;
                hostConfig.hp = Math.round(40 * waveScale * diff.enemyHpMult);
                hostConfig.maxHp = hostConfig.hp;
                hostConfig.speed = 3.45 * diff.enemySpeedMult;
                hostConfig.damage = Math.round(16 * diff.enemyDmgMult);
                hostConfig.color = "#00f0ff";
                hostConfig.shardDrop = 5;
            } else if (type === 'spitter') {
                hostConfig.name = "Mutagen Spitter";
                hostConfig.radius = 17;
                hostConfig.hp = Math.round(68 * waveScale * diff.enemyHpMult);
                hostConfig.maxHp = hostConfig.hp;
                hostConfig.speed = 1.85 * diff.enemySpeedMult;
                hostConfig.damage = Math.round(15 * diff.enemyDmgMult);
                hostConfig.color = "#c084fc";
                hostConfig.shardDrop = 6;
                hostConfig.shootCooldown = 1400;
            } else if (type === 'juggernaut') {
                hostConfig.name = "Isotope Juggernaut";
                hostConfig.radius = 26;
                hostConfig.hp = Math.round(215 * waveScale * diff.enemyHpMult);
                hostConfig.maxHp = hostConfig.hp;
                hostConfig.speed = 1.38 * diff.enemySpeedMult;
                hostConfig.damage = Math.round(28 * diff.enemyDmgMult);
                hostConfig.color = "#10b981";
                hostConfig.shardDrop = 14;
            }

            if (scene3D) {
                hostConfig.mesh = create3DHostMesh(hostConfig);
            }
            enemies.push(hostConfig);
        }

        function handleEnemyDeath(enemy, index) {
            sound.playHit(true);
            waveData.totalKills++;
            careerData.totalKills++;
            if (player) {
                player.hitmarkerTimer = 180;
                player.hitmarkerKill = true;
            }
            if (enemy.mesh && scene3D) {
                scene3D.remove(enemy.mesh);
            }

            // 3D Floor Blood / Bio-Ichor Splatters
            if (floorDecals.length > 90) {
                const oldest = floorDecals.shift();
                if (oldest.mesh && scene3D) scene3D.remove(oldest.mesh);
            }
            const decalRadius = enemy.radius * (1.2 + Math.random() * 0.5);
            let decalMesh = null;
            if (scene3D) {
                const dColor = enemy.type === 'stalker' ? 0x00f0ff :
                               enemy.type === 'juggernaut' ? 0x10b981 : 0xbe123c;
                decalMesh = new THREE.Mesh(
                    new THREE.CircleGeometry(decalRadius, 14),
                    new THREE.MeshBasicMaterial({ color: dColor, transparent: true, opacity: 0.35, depthWrite: false })
                );
                decalMesh.rotation.x = -Math.PI / 2;
                decalMesh.position.set(enemy.x, 0.4 + Math.random() * 0.2, enemy.y);
                scene3D.add(decalMesh);
            }
            floorDecals.push({
                x: enemy.x,
                y: enemy.y,
                radius: decalRadius,
                mesh: decalMesh
            });

            spawnParticles(enemy.x, enemy.y, enemy.color, 14, 4.2, 3.5, 24);

            // Isotope Juggernaut ruptures into a corrosive 3D Bio-Acid pool on death
            if (enemy.type === 'juggernaut') {
                let poolMesh = null;
                if (scene3D) {
                    poolMesh = new THREE.Mesh(
                        new THREE.CircleGeometry(68, 24),
                        new THREE.MeshBasicMaterial({ color: 0x10b981, transparent: true, opacity: 0.52, depthWrite: false })
                    );
                    poolMesh.rotation.x = -Math.PI / 2;
                    poolMesh.position.set(enemy.x, 0.8, enemy.y);
                    scene3D.add(poolMesh);
                }
                acidPools.push({
                    x: enemy.x,
                    y: enemy.y,
                    radius: 68,
                    life: 480, // ~8 seconds
                    maxLife: 480,
                    mesh: poolMesh
                });
                addFloatingText(enemy.x, enemy.y, "BIO-ACID RUPTURE!", "#10b981", 13);
                screenShake = Math.max(screenShake, 7);
            }

            // Spawn 3D Rotating 294-Og Isotope Shard pickup
            const diff = DIFFICULTY_PRESETS[selectedDifficulty];
            const shardAmount = Math.max(1, Math.round(enemy.shardDrop * diff.shardMult));
            const sx = enemy.x + (Math.random() - 0.5) * 14;
            const sy = enemy.y + (Math.random() - 0.5) * 14;
            let shardMesh = null;
            if (scene3D) {
                shardMesh = new THREE.Mesh(
                    new THREE.OctahedronGeometry(6.5, 0),
                    new THREE.MeshBasicMaterial({ color: 0xfbbf24, wireframe: false })
                );
                shardMesh.position.set(sx, 12, sy);
                scene3D.add(shardMesh);
            }
            shards.push({
                x: sx,
                y: sy,
                amount: shardAmount,
                radius: 9,
                pulse: Math.random() * Math.PI * 2,
                mesh: shardMesh
            });

            enemies.splice(index, 1);
            updateHud();
        }

        function applyDamageToPlayer(amount, sourceX = null, sourceY = null) {
            if (!player || player.invulnTimer > 0) return;

            player.invulnTimer = 280; // brief grace window
            player.shieldRegenDelay = 4200; // wait 4.2s before recharging QECC shield

            // Record Directional Threat Indicator Angle relative to Player Heading
            if (sourceX !== null && sourceY !== null) {
                const worldAng = Math.atan2(sourceY - player.y, sourceX - player.x);
                const relAng = worldAng - player.angle;
                damageDirectionalIndicators.push({ angle: relAng, alpha: 1.0 });
            }

            let remaining = amount;
            if (player.shield > 0) {
                const absorbed = Math.min(player.shield, remaining);
                player.shield -= absorbed;
                remaining -= absorbed;
            }
            if (remaining > 0) {
                player.hp = Math.max(0, player.hp - remaining);
            }

            screenShake = 8;
            haptics.damage();
            const overlay = document.getElementById('damageOverlay');
            overlay.style.opacity = '1';
            setTimeout(() => { overlay.style.opacity = '0'; }, 180);

            updateHud();

            if (player.hp <= 0) {
                triggerGameOver();
            }
        }

        // ==========================================
        // 10. SECONDARY OBJECTIVES (3D QECC NODES)
        // ==========================================
