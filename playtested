                : `${(player.shockwaveCooldown / 1000).toFixed(1)}s`;

            // Biometric BPM & Mitosis Status
            const hpRatio = player.hp / player.maxHp;
            const bpm = Math.round(74 + (1 - hpRatio) * 88);
            const bpmEl = document.getElementById('hudBpmText');
            const bioEl = document.getElementById('hudBioStatusText');
            if (bpmEl && bioEl) {
                bpmEl.textContent = `${bpm} BPM`;
