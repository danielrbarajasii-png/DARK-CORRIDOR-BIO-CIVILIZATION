            border: 1px solid rgba(255, 42, 84, 0.48);
            box-shadow: 0 6px 32px rgba(255, 42, 84, 0.2), inset 0 0 22px rgba(255, 42, 84, 0.1);
        }

        .tech-btn {
            position: relative;
            overflow: hidden;
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .tech-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.38);
        }

        .tech-btn:active:not(:disabled) {
            transform: translateY(1px);
        }

        #webglCanvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            z-index: 1;
            touch-action: none;
        }

        #gameCanvas {
            position: fixed;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            z-index: 12;
            pointer-events: none;
        }

        .touch-action-none {
            touch-action: none;
        }

        .fps-touch-btn {
            backdrop-filter: blur(8px);
            transition: transform 0.1s ease, background-color 0.15s ease, box-shadow 0.15s ease;
            touch-action: none;
        }

        .fps-touch-btn:active, .fps-touch-btn.active-toggle {
            transform: scale(0.93);
            box-shadow: 0 0 22px rgba(0, 240, 255, 0.55);
        }

        /* Mobile App Safe-Area & Compact HUD Mode */
        .safe-area-pad {
            padding-top: max(0.5rem, env(safe-area-inset-top));
            padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
            padding-left: max(0.65rem, env(safe-area-inset-left));
            padding-right: max(0.65rem, env(safe-area-inset-right));
        }

        body.compact-mobile-hud #hudCommsBox,
        body.compact-mobile-hud #visorFrameOverlay {
            display: none !important;
        }

        body.compact-mobile-hud #hudBiometricsPanel {
