        function circleRectCollide(cx, cy, cr, rx, ry, rw, rh) {
            const closestX = Math.max(rx, Math.min(cx, rx + rw));
            const closestY = Math.max(ry, Math.min(cy, ry + rh));
            const dx = cx - closestX;
            const dy = cy - closestY;
            return (dx * dx + dy * dy) < (cr * cr);
        }

        function resolveObstacleCollisions(entity) {
            // Clamp to World Bounds
            entity.x = Math.max(entity.radius + 20, Math.min(WORLD_WIDTH - entity.radius - 20, entity.x));
            entity.y = Math.max(entity.radius + 20, Math.min(WORLD_HEIGHT - entity.radius - 20, entity.y));

            for (const obs of obstacles) {
                const closestX = Math.max(obs.x, Math.min(entity.x, obs.x + obs.w));
                const closestY = Math.max(obs.y, Math.min(entity.y, obs.y + obs.h));
                const dx = entity.x - closestX;
                const dy = entity.y - closestY;
                const distSq = dx * dx + dy * dy;
                if (distSq < entity.radius * entity.radius) {
                    const dist = Math.sqrt(distSq) || 0.001;
                    const overlap = entity.radius - dist;
                    entity.x += (dx / dist) * overlap;
                    entity.y += (dy / dist) * overlap;
                }
            }
        }

